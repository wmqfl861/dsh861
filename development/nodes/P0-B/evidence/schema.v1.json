{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "P0-B harness evidence",
  "type": "object",
  "required": ["node", "planVersion", "harness", "case", "mode", "status", "runId", "program", "version", "command", "environment", "directories", "permissions", "tools", "process", "filesystem", "session", "handoff", "artifacts", "usage", "native", "blockedConditions", "timestamps", "cleanup"],
  "properties": {
    "node": {"const": "P0-B"},
    "planVersion": {"const": "v1"},
    "harness": {"enum": ["codex", "claude-code", "opencode", "grok"]},
    "case": {"enum": ["allow", "deny"]},
    "mode": {"enum": ["source", "artifact"]},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "runId": {"type": "string", "minLength": 1},
    "requireRealProduct": {"type": "boolean"},
    "expectDenied": {"type": "boolean"},
    "program": {"type": "object", "required": ["value", "status"], "properties": {"value": {"type": "object"}, "status": {"enum": ["OBSERVED", "UNKNOWN"]}, "reason": {"type": "string"}}},
    "version": {"type": "object", "required": ["value", "status"], "properties": {"value": {"type": "string"}, "status": {"enum": ["OBSERVED", "UNKNOWN"]}, "reason": {"type": "string"}}},
    "command": {"type": "object", "required": ["argv", "argvSha256"], "properties": {"argv": {"type": "array", "items": {"type": "string"}}, "argvSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "environment": {"type": "object", "required": ["names", "secretValuesRecorded"], "properties": {"names": {"type": "array", "items": {"type": "string"}}, "secretValuesRecorded": {"const": false}}},
    "directories": {"type": "object", "required": ["root", "config", "authReference", "home", "cache", "session", "logs", "work", "bait", "artifacts", "process", "raw"], "additionalProperties": {"type": "string"}},
    "permissions": {"type": "object", "required": ["requested", "observed", "reason"], "properties": {"requested": {"type": "string"}, "observed": {"const": "UNKNOWN"}, "reason": {"type": "string"}}},
    "tools": {"type": "object", "required": ["visible", "callable", "allowed", "denied", "status", "reason"], "properties": {"visible": {"type": "array", "items": {"type": "string"}}, "callable": {"type": "array", "items": {"type": "string"}}, "allowed": {"type": "array", "items": {"type": "string"}}, "denied": {"type": "array", "items": {"type": "string"}}, "status": {"const": "UNKNOWN"}, "reason": {"type": "string"}}},
    "process": {"type": "object", "required": ["before", "during", "after", "quiescent", "reason"], "properties": {"before": {"type": "array"}, "during": {"type": "array"}, "after": {"type": "array"}, "quiescent": {"enum": ["OBSERVED", "UNKNOWN", "NOT_RUN"]}, "reason": {"type": "string"}}},
    "filesystem": {"type": "object", "required": ["before", "after", "allowedTarget", "baitTarget", "status", "reason"], "properties": {"before": {"type": "array"}, "after": {"type": "array"}, "allowedTarget": {"type": "string"}, "baitTarget": {"type": "string"}, "status": {"enum": ["OBSERVED", "UNKNOWN", "NOT_RUN"]}, "reason": {"type": "string"}}},
    "session": {"type": "object", "required": ["value", "status"], "properties": {"value": {"type": "object"}, "status": {"enum": ["OBSERVED", "UNKNOWN"]}, "reason": {"type": "string"}}},
    "handoff": {"type": "object", "required": ["value", "status"], "properties": {"value": {"type": "object"}, "status": {"enum": ["OBSERVED", "UNKNOWN"]}, "reason": {"type": "string"}}},
    "artifacts": {"type": "object", "required": ["paths", "sha256"], "properties": {"paths": {"type": "array", "items": {"type": "string"}}, "sha256": {"type": "array", "items": {"type": "string"}}}},
    "usage": {"type": "object", "required": ["value", "status"], "properties": {"value": {}, "status": {"enum": ["OBSERVED", "UNKNOWN"]}, "reason": {"type": "string"}}},
    "native": {"type": "object", "required": ["value", "status"], "properties": {"value": {}, "status": {"enum": ["OBSERVED", "UNKNOWN"]}, "reason": {"type": "string"}}},
    "blockedConditions": {"type": "array", "items": {"type": "string"}},
    "timestamps": {"type": "object", "required": ["startedAt", "finishedAt"], "properties": {"startedAt": {"type": "string"}, "finishedAt": {"type": "string"}}},
    "cleanup": {"type": "object", "required": ["rootRemoved", "ownedResourcesOnly"], "properties": {"rootRemoved": {"type": "boolean"}, "ownedResourcesOnly": {"const": true}}}
  },
  "additionalProperties": false
}
