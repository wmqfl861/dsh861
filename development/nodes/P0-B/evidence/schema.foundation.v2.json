{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strict legacy B2 foundation overlay (not the product evidence v2 schema)",
  "description": "Validate legacy foundation records with both schema.v1.json and this overlay. Foundation success is never product acceptance.",
  "allOf": [
    { "$ref": "schema.v1.json" },
    {
      "type": "object",
      "properties": {
        "status": { "const": "BLOCKED" },
        "blockedConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "program": { "properties": { "status": { "const": "UNKNOWN" } } },
        "version": { "properties": { "status": { "const": "UNKNOWN" } } },
        "session": { "properties": { "status": { "const": "UNKNOWN" } } },
        "handoff": { "properties": { "status": { "const": "UNKNOWN" } } },
        "usage": { "properties": { "status": { "const": "UNKNOWN" }, "value": { "type": "null" } } },
        "native": { "properties": { "status": { "const": "UNKNOWN" }, "value": { "type": "null" } } },
        "process": { "properties": { "quiescent": { "const": "NOT_RUN" }, "before": { "maxItems": 0 }, "during": { "maxItems": 0 }, "after": { "maxItems": 0 } } },
        "filesystem": { "properties": { "status": { "const": "NOT_RUN" }, "before": { "maxItems": 0 }, "after": { "maxItems": 0 } } },
        "artifacts": { "properties": { "paths": { "maxItems": 0 }, "sha256": { "maxItems": 0 } } },
        "tools": { "properties": { "visible": { "maxItems": 0 }, "callable": { "maxItems": 0 }, "allowed": { "maxItems": 0 }, "denied": { "maxItems": 0 } } },
        "cleanup": { "properties": { "rootRemoved": { "const": false } } }
      }
    }
  ]
}
